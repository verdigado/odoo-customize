<odoo>
    <record
        id="res_config_settings_view_form_inherit_hr_leave_request"
        model="ir.ui.view"
    >
        <field name="name">
            res.config.settings.view.form.inherit.hr.leave.request
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[hasclass('app_settings_block') and @data-key='hr']"
                position="inside"
            >
                <h2>Leave Requests</h2>
                <div
                    class="row mt16 o_settings_container"
                    name="leave_requests_setting_container"
                >
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <field name="requests_default_leave_type_id" />
                            <div class="text-muted">
                                Default leave type for leave requests
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane" />
                        <div class="o_setting_right_pane">
                            <field name="manager_email" />
                            <div class="text-muted">
                                Default email address for leave request notifications
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
