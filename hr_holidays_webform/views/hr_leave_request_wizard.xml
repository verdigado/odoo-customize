<odoo>
    <record id="view_hr_leave_request_wizard_form" model="ir.ui.view">
        <field name="name">hr.leave.request.wizard.form</field>
        <field name="model">hr.leave.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Leaves">
                <group>
                    <field name="request_id" readonly="1" />
                </group>
                <group>
                    <group>
                        <field name="employee_id" />
                        <field name="leave_type_id" />
                    </group>
                    <group>
                        <field name="start_date" />
                        <field name="end_date" />
                    </group>
                </group>
                <footer>
                    <button
                        string="Create"
                        type="object"
                        name="action_create_leave"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
