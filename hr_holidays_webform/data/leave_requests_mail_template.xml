<odoo noupdate="1">
    <record id="mail_template_hr_leave_request" model="mail.template">
        <field name="name">Leave Request Notification</field>
        <field name="model_id" ref="model_hr_leave_request" />
        <field name="subject">New {{ object.name }}</field>
        <field name="email_to">{{ object.env['ir.config_parameter'].sudo().get_param('hr_leave_request.manager_email', 'manager@example.com') }}</field>
        <field name="body_html">
            <![CDATA[
            <p>Hello,</p>
            <p>A new leave request has been submitted:</p>
            <ul>
                <li><strong>Employee:</strong> <t t-out="object.employee_name"</t></li>
                <li><strong>From:</strong> <t t-out="object.start_date"</t></li>
                <li><strong>To:</strong> <t t-out="object.end_date"</t></li>
                <li><strong>Certificate:</strong> <t t-out="object.get_selection_label('certificate_type')"</t></li>
            </ul>
            <p>Regards,<br/>Odoo</p>
            ]]>
        </field>
    </record>
</odoo>
