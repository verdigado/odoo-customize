<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- original template is in addons/mail/data/mail_templates_email_layouts.xml -->
    <template id="verdigado_mail_notification_layout" inherit_id="mail.mail_notification_layout" priority="100">
        <!-- The replaced div carries two things: the "Powered by Odoo" note we
             want gone, and <span id="mail_unfollow">. mail.mail_notification_invite
             xpaths onto exactly that span (mail/data/mail_templates_invite.xml),
             so dropping it makes the module fail to load. Keep the span, and keep
             the t-if wrapper as well - without it the logo showed even where the
             footer was suppressed. -->
        <xpath expr="//div[@t-if='show_footer' and @style='color: #555555; font-size:11px;']" position="replace">
            <div t-if="show_footer" style="color: #555555; font-size:11px;">
                <a href="https://www.verdigado.com">
                    <img t-attf-src="/verdigado_template_default/static/img/verdigado_Logo.png" t-att-style="'max-width:250px;'" t-att-alt="'Logo von verdigado eG mit Claim IT_with_attitude'" />
                </a>
                <span t-if="show_unfollow" id="mail_unfollow">
                    | <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">Unfollow</a>
                </span>
            </div>
        </xpath>
    </template>

    <template id="verdigado_mail_bounce_catchall" inherit_id="mail.mail_bounce_catchall" priority="100">
        <!-- we replace the whole template... -->
        <xpath expr="." position="replace">
            <div>
                <p>
                    Hallo
                    <t t-out="message['email_from']" />
                    ,
                </p>
                <p>
                    Du schreibst uns an
                    <t t-out="message['to']" />
                    , was nur eine technische Hilfs-Adresse ist.
                </p>
                <p>
                    Deine Mail haben wir trotzdem an unser Ticket-System weitergeleitet
                    und
          antworten Dir bald.
                </p>
                <p>
                    Bitte nutze für zukünftige Anfragen an die
                    <t t-out="res_company.name" />
                    die Adresse
                    <a t-att-href="'mailto:%s' % res_company.email">
                        <t t-out="res_company.email" />
                    </a>
                    .
                </p>
                <p>Viele Grüße</p>
                <p>
                    das Team der
                    <t t-out="res_company.name" />
                </p>
            </div>
            <blockquote>
                <t t-out="message['body']" />
            </blockquote>
        </xpath>
    </template>
</odoo>
