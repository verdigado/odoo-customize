                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record> -->

        <record id="action_res_partner_verdigado_domain_form" model="ir.actions.act_window">
            <field name="name">Verdigado Domains</field>
            <field name="res_model">verdigado.domain</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                Create a Domain
                </p>
                <p>
                From here you can manage all verdigado domains linked to you and your contacts.
                </p>
            </field>
        </record>

    </data>
</odoo>
