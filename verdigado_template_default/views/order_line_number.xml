<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="verdigado_report_saleorder_document_sequence" inherit_id="sale_order_line_sequence.report_saleorder_document_sequence" priority="100">
        <xpath expr="//table[hasclass('table')]/thead/tr/th[@name='th_description']" position="replace">
            <th class="text-right">Pos</th>
        </xpath>
        <xpath expr="//tbody[hasclass('sale_tbody')]//td[@name='td_name']/span[@t-field='line.name']/.." position="replace">
            <td class="text-right">
                <span t-field="line.visible_sequence" />
            </td>
        </xpath>
    </template>
</odoo>
