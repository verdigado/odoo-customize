<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="verdigado_view_partner_form_inherit" model="ir.ui.view">
        <field name="name">verdigado.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//group/group/field[@name='vat']" position="after">
                <field name="x_gliederungsid" />
                <field name="x_kunde_hosting" />
                <field name="x_hauptdomain" />
            </xpath>
        </field>
    </record>

    <record id="verdigado_view_res_partner_filter" model="ir.ui.view">
        <field name="name">res.partner.select</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="x_hauptdomain" />
                <field name="x_gliederungsid" />
            </xpath>
            <xpath expr="//group[@name='group_by']/filter[@name='group_country']" position="after">
                <filter name="x_kunde_hosting" context="{'group_by': 'x_kunde_hosting'}"/>
            </xpath>
        </field>
    </record>

</odoo>
