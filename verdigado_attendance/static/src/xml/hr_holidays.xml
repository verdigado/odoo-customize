<?xml version="1.0" encoding="utf8" ?>
<templates>
    <t t-inherit="hr_holidays.dashboard_calendar_header">
        <!--
            with hr_attendance_holidays, we end up with a conditional like
            <t t-if="">
                <span t-esc="timeoff[1]['virtual_remaining_leaves']" />
            </t>
            <t t-elif="">
                <span t-esc="timeoff[1]['virtual_remaining_leaves']" />
            </t>
            <t t-else="">
                <span t-esc="timeoff[1]['virtual_leaves_taken']" />
            </t>
            and we replace all of them with the formatted version
        /-->
        <xpath
            expr="//span[@t-esc=&quot;timeoff[1]['virtual_remaining_leaves']&quot; or @t-esc=&quot;timeoff[1]['usable_remaining_leaves']&quot;]"
            position="attributes"
        >
            <!-- prettier-ignore-start -->
            <attribute name="t-esc">timeoff[1]['usable_remaining_leaves_formatted']</attribute>
            <!-- prettier-ignore-end -->
        </xpath>
        <xpath
            expr="//span[@t-esc=&quot;timeoff[1]['virtual_remaining_leaves']&quot; or @t-esc=&quot;timeoff[1]['usable_remaining_leaves']&quot;]"
            position="attributes"
        >
            <!-- prettier-ignore-start -->
            <attribute name="t-esc">timeoff[1]['usable_remaining_leaves_formatted']</attribute>
            <!-- prettier-ignore-end -->
        </xpath>
        <xpath
            expr="//span[@t-esc=&quot;timeoff[1]['virtual_leaves_taken']&quot;]"
            position="attributes"
        >
            <!-- prettier-ignore-start -->
            <attribute name="t-esc">timeoff[1]['virtual_leaves_taken_formatted']</attribute>
            <!-- prettier-ignore-end -->
        </xpath>
        <!--
            create an a node and move the span for the time into it,
            also three times for every branch of the above conditional
        /-->
        <xpath
            expr="//t/span[@t-esc=&quot;timeoff[1]['usable_remaining_leaves_formatted']&quot;]"
            position="before"
        >
            <a
                t-att-type="timeoff[1]['dashboard_action_id'] and 'action' or None"
                t-att-name="timeoff[1]['dashboard_action_id'] or None"
            />
        </xpath>
        <xpath expr="//a[count(*) = 0]" position="inside">
            <xpath
                expr="//t/span[@t-esc=&quot;timeoff[1]['usable_remaining_leaves_formatted']&quot;]"
                position="move"
            />
        </xpath>
        <xpath
            expr="//t/span[@t-esc=&quot;timeoff[1]['usable_remaining_leaves_formatted']&quot;]"
            position="before"
        >
            <a
                t-att-type="timeoff[1]['dashboard_action_id'] and 'action' or None"
                t-att-name="timeoff[1]['dashboard_action_id'] or None"
            />
        </xpath>
        <xpath expr="//a[count(*) = 0]" position="inside">
            <xpath
                expr="//t/span[@t-esc=&quot;timeoff[1]['usable_remaining_leaves_formatted']&quot;]"
                position="move"
            />
        </xpath>
        <xpath
            expr="//t/span[@t-esc=&quot;timeoff[1]['virtual_leaves_taken_formatted']&quot;]"
            position="before"
        >
            <a
                t-att-type="timeoff[1]['dashboard_action_id'] and 'action' or None"
                t-att-name="timeoff[1]['dashboard_action_id'] or None"
            />
        </xpath>
        <xpath expr="//a[count(*) = 0]" position="inside">
            <xpath
                expr="//t/span[@t-esc=&quot;timeoff[1]['virtual_leaves_taken_formatted']&quot;]"
                position="move"
            />
        </xpath>
        <xpath expr="(//div[hasclass('mt-1')]/t)[1]" position="inside">
            <span t-if="timeoff[1]['overlap']['time'] > 0">
                <br />
                (incl.
                <t t-out="timeoff[1]['overlap']['time']" />
                from
                <!-- prettier-ignore-start -->
                <a
                    href="#"
                    class="overlap"
                    t-att-data-ids="JSON.stringify(timeoff[1]['overlap']['ids'])"
                >
                    overlaps
                </a>)
                <!-- prettier-ignore-end -->
            </span>
        </xpath>
        <xpath expr="(//div[hasclass('mt-1')]/t)[2]" position="inside">
            <span t-if="timeoff[1]['overlap']['time'] > 0">
                <br />
                (incl.
                <t t-out="timeoff[1]['overlap']['time']" />
                from
                <!-- prettier-ignore-start -->
                <a
                    href="#"
                    class="overlap"
                    t-att-data-ids="JSON.stringify(timeoff[1]['overlap']['ids'])"
                >
                    overlaps
                </a>)
                <!-- prettier-ignore-end -->
            </span>
        </xpath>
        <xpath expr="(//div[hasclass('mt-1')]/t)[3]" position="inside">
            <span t-if="timeoff[1]['overlap']['time'] > 0">
                <br />
                (incl.
                <t t-out="timeoff[1]['overlap']['time']" />
                from
                <!-- prettier-ignore-start -->
                <a
                    href="#"
                    class="overlap"
                    t-att-data-ids="JSON.stringify(timeoff[1]['overlap']['ids'])"
                >
                    overlaps
                </a>)
                <!-- prettier-ignore-end -->
            </span>
        </xpath>
        <!--
            breakdown per allocation year, again once per branch of the
            conditional above. Allocations stay valid until March 31st of the
            following year, so between January and March the number above is
            the sum of two allocations, which is what we explain here.
        /-->
        <xpath expr="(//div[hasclass('mt-1')]/t)[1]" position="inside">
            <span
                t-if="timeoff[1]['per_year'] &amp;&amp; timeoff[1]['per_year'].length"
            >
                <br />
                <!-- prettier-ignore-start -->
                <a href="#" class="per_year">per year</a>
                <!-- prettier-ignore-end -->
                <span class="per_year_content d-none">
                    <span t-foreach="timeoff[1]['per_year']" t-as="per_year_entry">
                        <t t-if="per_year_entry['year']">
                            entitlement
                            <t t-out="per_year_entry['year']" />
                            :
                            <t t-out="per_year_entry['max_leaves']" />
                            ,
                            taken
                            <t t-out="per_year_entry['leaves_taken']" />
                            <t t-if="per_year_entry['expired']">
                                ,
                                <t t-out="per_year_entry['expired']" />
                                expired
                            </t>
                        </t>
                        <t t-else="">
                            <t t-out="per_year_entry['leaves_taken']" />
                            without allocation
                        </t>
                        <br />
                    </span>
                </span>
            </span>
        </xpath>
        <xpath expr="(//div[hasclass('mt-1')]/t)[2]" position="inside">
            <span
                t-if="timeoff[1]['per_year'] &amp;&amp; timeoff[1]['per_year'].length"
            >
                <br />
                <!-- prettier-ignore-start -->
                <a href="#" class="per_year">per year</a>
                <!-- prettier-ignore-end -->
                <span class="per_year_content d-none">
                    <span t-foreach="timeoff[1]['per_year']" t-as="per_year_entry">
                        <t t-if="per_year_entry['year']">
                            entitlement
                            <t t-out="per_year_entry['year']" />
                            :
                            <t t-out="per_year_entry['max_leaves']" />
                            ,
                            taken
                            <t t-out="per_year_entry['leaves_taken']" />
                            <t t-if="per_year_entry['expired']">
                                ,
                                <t t-out="per_year_entry['expired']" />
                                expired
                            </t>
                        </t>
                        <t t-else="">
                            <t t-out="per_year_entry['leaves_taken']" />
                            without allocation
                        </t>
                        <br />
                    </span>
                </span>
            </span>
        </xpath>
        <xpath expr="(//div[hasclass('mt-1')]/t)[3]" position="inside">
            <span
                t-if="timeoff[1]['per_year'] &amp;&amp; timeoff[1]['per_year'].length"
            >
                <br />
                <!-- prettier-ignore-start -->
                <a href="#" class="per_year">per year</a>
                <!-- prettier-ignore-end -->
                <span class="per_year_content d-none">
                    <span t-foreach="timeoff[1]['per_year']" t-as="per_year_entry">
                        <t t-if="per_year_entry['year']">
                            entitlement
                            <t t-out="per_year_entry['year']" />
                            :
                            <t t-out="per_year_entry['max_leaves']" />
                            ,
                            taken
                            <t t-out="per_year_entry['leaves_taken']" />
                            <t t-if="per_year_entry['expired']">
                                ,
                                <t t-out="per_year_entry['expired']" />
                                expired
                            </t>
                        </t>
                        <t t-else="">
                            <t t-out="per_year_entry['leaves_taken']" />
                            without allocation
                        </t>
                        <br />
                    </span>
                </span>
            </span>
        </xpath>
    </t>
</templates>
